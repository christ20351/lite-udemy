generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────

enum Role {
  ADMIN // gère l'équipe et tout le back-office
  GESTIONNAIRE // crée les formations, assigne les formateurs, publie
  FORMATEUR // construit le contenu des formations qui lui sont assignées
  APPRENANT // portail : catalogue, mes formations, sessions
}

enum FormationMode {
  ONLINE
  ONSITE
  HYBRID
}

enum FormationStatus {
  DRAFT
  PUBLISHED
}

enum SessionModality {
  PRESENTIEL
  ONLINE
}

// ─── Utilisateurs ─────────────────────────────────────────────────────

/// Un compte = une personne avec un rôle unique : membre de l'équipe
/// (ADMIN / GESTIONNAIRE / FORMATEUR) ou apprenant (APPRENANT).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(APPRENANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  grantedAccesses Enrollment[]         @relation("EnrollmentGranter")
  enrollments     Enrollment[]
  progresses      LessonProgress[]
  sessionsTrained Session[]            @relation("SessionTrainer")
  participations  SessionParticipant[]
  formationsTaught Formation[]         @relation("FormationInstructors")
  quizAttempts    QuizAttempt[]
  notifications   Notification[]
}

// ─── Catalogue formations ─────────────────────────────────────────────

model Formation {
  id           String          @id @default(cuid())
  title        String
  slug         String          @unique
  description  String?
  category     String?
  mode         FormationMode   @default(ONLINE)
  status       FormationStatus @default(DRAFT)
  thumbnailUrl String?
  /// null = gratuite · sinon prix indicatif en € (pas de paiement en ligne en v1)
  price        Float?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  instructors User[]            @relation("FormationInstructors")
  sections    Section[]
  sessions    Session[]
  enrollments Enrollment[]
}

model Section {
  id          String    @id @default(cuid())
  title       String
  position    Int       @default(0)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@index([formationId])
}

/// Leçon : contenu texte riche (content) et/ou vidéo (videoPath).
model Lesson {
  id        String  @id @default(cuid())
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  videoPath String?
  /// Contenu structuré : [{type:"text"|"image"|"code"|"callout", text, url?, caption?}]
  blocks    Json?
  duration  Int?
  position  Int     @default(0)
  isPreview Boolean @default(false)

  progresses   LessonProgress[]
  quiz         Quiz?
  quizAttempts QuizAttempt[]

  @@index([sectionId])
}

// ─── Inscriptions ─────────────────────────────────────────────────────

/// L'inscription directe d'un apprenant à une formation : créée en
/// auto-inscription (formation gratuite) ou accordée par l'équipe
/// (formation payante payée hors ligne, en attendant le paiement en ligne).
model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  /// null = auto-inscription de l'apprenant
  grantedById String?
  grantedBy   User?     @relation("EnrollmentGranter", fields: [grantedById], references: [id])
  grantedAt   DateTime  @default(now())

  @@unique([userId, formationId])
}

// ─── Suivi de progression ─────────────────────────────────────────────

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed    Boolean  @default(false)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, lessonId])
}

// ─── Présentiel ───────────────────────────────────────────────────────

model Session {
  id          String    @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  title       String
  startAt     DateTime
  endAt       DateTime
  location    String?
  capacity    Int       @default(10)
  modality    SessionModality @default(PRESENTIEL)
  meetingUrl  String?
  trainerId   String?
  trainer     User?     @relation("SessionTrainer", fields: [trainerId], references: [id])

  participants SessionParticipant[]

  @@index([formationId])
}

model SessionParticipant {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attended     Boolean  @default(false)
  registeredAt DateTime @default(now())

  @@unique([sessionId, userId])
}

// ─── Notifications internes ───────────────────────────────────────────

/// Message interne adressé à un membre de l'équipe (ex : formateur
/// prévenu d'une nouvelle formation assignée).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // ex : FORMATION_ASSIGNED
  title     String
  body      String?
  /// Chemin frontend vers la ressource concernée
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// ─── Quiz ─────────────────────────────────────────────────────────────

model Quiz {
  id       String @id @default(cuid())
  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]  @relation("QuizAttemptQuiz")
}

model QuizQuestion {
  id      String @id @default(cuid())
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text    String
  choices Json   // [{text: string, correct: boolean}]
  order   Int    @default(0)

  @@index([quizId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation("QuizAttemptQuiz", fields: [quizId], references: [id], onDelete: Cascade)
  score     Int
  total     Int
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
}
